# Local defaults: SQLite + local cache. Use .env for API and Worker.
WEB_ENV=development
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# WEB_DATA_ROOT=/absolute/path/to/volume_bottom_backtest
# BACKTEST_CONFIG=/absolute/path/to/config.yaml
STORAGE_BACKEND=local
# STORAGE_DIR=/absolute/path/to/object-cache
# ARTIFACT_CACHE_DIR=/absolute/path/to/api-cache
# API_TOKEN=set-a-long-random-token-for-production
# Supabase: private bucket, increase upload size limit for Parquet if necessary.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret
STORAGE_BUCKET=backtests
# S3 alternative: STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://s3.example.com
# AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=server-only-secret
# AWS_SECRET_ACCESS_KEY=server-only-secret
# Optional AI commentary (server-only API/Worker; never NEXT_PUBLIC_*).
# Without a key the AI分析 tab shows an explicitly labeled statistical report.
# OPENAI_API_KEY=server-only-secret
AI_ANALYSIS_MODEL=gpt-4.1-mini-2025-04-14
